[Unit]
Description=HomeWizard P1 to Cloudflare relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/data/p1-relay
ExecStart=/usr/bin/python3 /data/p1-relay/p1_relay.py --config /data/p1-relay/relay.config.json
Environment=TZ=Atlantic/Reykjavik
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=15
TimeoutStopSec=20
Nice=10
CPUQuota=5%
MemoryHigh=48M
MemoryMax=96M
TasksMax=16
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/data/p1-relay/data /data/p1-relay/logs

[Install]
WantedBy=multi-user.target
